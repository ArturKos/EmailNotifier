# Minimal Doxygen configuration for EmailNotifier.
# Generate HTML docs with: doxygen docs/Doxyfile
# Or from the CMake build directory: cmake --build build --target docs

PROJECT_NAME           = "EmailNotifier"
PROJECT_BRIEF          = "Terminal-based POP3 new-mail notifier"
PROJECT_NUMBER         = 1.0.0

OUTPUT_DIRECTORY       = docs/build
CREATE_SUBDIRS         = NO

INPUT                  = include src README.md
FILE_PATTERNS          = *.c *.h *.md
RECURSIVE              = YES

USE_MDFILE_AS_MAINPAGE = README.md

EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = NO

JAVADOC_AUTOBRIEF      = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
TAB_SIZE               = 4

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html

WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO

QUIET                  = YES
